{
  "name": "@line-os/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./crypto": "./src/crypto.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/backup.test.ts",
    "seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "gen:types": "supabase gen types typescript --local --schema core,audit,workforce,booking,ai > src/types.generated.ts"
  },
  "dependencies": {
    "@line-os/config": "workspace:*",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
