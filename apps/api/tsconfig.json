{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "composite": false,
    "verbatimModuleSyntax": false,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"]
}
