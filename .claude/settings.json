{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.local*)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./supabase/.temp/**)",
      "Read(./backups/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(supabase link*)",
      "Bash(supabase db push*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(supabase db pull*)",
      "Bash(pnpm exec supabase db pull*)",
      "Bash(supabase migration repair*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(git push --force*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(Remove-Item -Recurse -Force*)",
      "Bash(gh pr merge*)",
      "Bash(*--amend*)",
      "Bash(*--no-verify*)"
    ],
    "ask": [
      "Bash(supabase db reset*)",
      "Bash(pnpm exec supabase db reset*)",
      "Bash(pnpm db:reset*)",
      "Bash(pnpm db:seed*)",
      "Bash(git push*)",
      "Edit(supabase/migrations/**)"
    ],
    "allow": [
      "Bash(bash scripts/ai-dev-merge.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git merge-tree*)",
      "Bash(git ls-tree*)",
      "Bash(git ls-remote*)",
      "Bash(git branch --show-current*)",
      "Bash(git branch -a*)",
      "Bash(git branch --contains*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh pr create*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr view*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm build*)",
      "Bash(pnpm install*)",
      "Bash(pnpm exec turbo run*)",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__emulate",
      "mcp__chrome-devtools__resize_page",
      "mcp__chrome-devtools__wait_for",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__get_network_request"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node scripts/ai-hooks/guard-no-verify.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "branch=$(git branch --show-current 2>/dev/null); head=$(git rev-parse --short HEAD 2>/dev/null); if [ -n \"$(git status --porcelain 2>/dev/null)\" ]; then tree=dirty; else tree=clean; fi; ctx=\"ORUWA session start. Read order: AGENTS.md -> docs/ai/ORUWA_AI_ENGINEERING_OPERATING_MODEL.md -> docs/ai/current-task.md. Founder-facing language default: Russian (see AGENTS.md, section Founder communication language). Current-task / next-gate source of truth: docs/ai/current-task.md. Git: branch=$branch head=$head tree=$tree.\"; printf '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"%s\"}}' \"$ctx\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
