# Local secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy to supabase/functions/.env (gitignored) and fill in real local values.
# SUPABASE_URL is injected automatically by the Supabase CLI when serving
# locally -- do not set it here.
#
# API KEYS (Phase 9 of the key migration -- Cloud DEV's legacy JWT-based
# anon/service_role API keys are disabled). The resolvers in
# _shared/supabase-secret-key.ts and _shared/supabase-publishable-key.ts now
# REQUIRE the JSON `*_KEYS` env vars with a non-empty "default" and have NO
# legacy fallback. Hosted Edge Functions receive these from Supabase
# (SUPABASE_SECRET_KEYS set as a function secret; SUPABASE_PUBLISHABLE_KEYS
# auto-injected). Locally, `supabase functions serve` does NOT inject them, so
# to run invite-employee / liff-entry locally you MUST set both here, using the
# demo key values `supabase start` prints:
#   SUPABASE_SECRET_KEYS={"default":"<local service_role / sb_secret value>"}
#   SUPABASE_PUBLISHABLE_KEYS={"default":"<local anon / sb_publishable value>"}

# Must match apps/web's own PII_ENCRYPTION_KEY (see .env.example) or
# invite-employee/liff-entry cannot decrypt the employee's contact email.
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Must match apps/web's own PII_HASH_PEPPER (see .env.example) or liff-entry
# cannot compute the same blind-index hash workforce.employee_line_links was
# written with, and every lookup will miss.
PII_HASH_PEPPER=replace-with-a-long-random-string

# Base URL the Supabase invite email's link redirects back to after
# verification. Must match supabase/config.toml's [auth] site_url locally.
SITE_URL=http://localhost:3000
