# Local secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy to supabase/functions/.env (gitignored) and fill in real local values.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Supabase CLI when serving locally -- do not set them here.
#
# PRIVILEGED KEY (migration): hosted Edge Functions receive SUPABASE_SECRET_KEYS
# (a JSON object with a "default" `sb_secret_*` value); the resolver in
# _shared/supabase-secret-key.ts prefers it and falls back to the legacy
# SUPABASE_SERVICE_ROLE_KEY during the transition. Locally, `supabase functions
# serve` still provides SUPABASE_SERVICE_ROLE_KEY, so no local change is needed;
# set SUPABASE_SECRET_KEYS below only to exercise the new path locally, e.g.
#   SUPABASE_SECRET_KEYS={"default":"<your-sb_secret-value>"}
#
# USER-SCOPED KEY (migration): hosted Edge Functions also receive
# SUPABASE_PUBLISHABLE_KEYS (a JSON object with a "default" publishable key);
# the resolver in _shared/supabase-publishable-key.ts prefers it for the
# user-scoped client and falls back to the legacy SUPABASE_ANON_KEY during the
# transition. Locally, `supabase functions serve` still provides
# SUPABASE_ANON_KEY, so no local change is needed; set SUPABASE_PUBLISHABLE_KEYS
# below only to exercise the new path locally, e.g.
#   SUPABASE_PUBLISHABLE_KEYS={"default":"<your-publishable-value>"}

# Must match apps/web's own PII_ENCRYPTION_KEY (see .env.example) or
# invite-employee/liff-entry cannot decrypt the employee's contact email.
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Must match apps/web's own PII_HASH_PEPPER (see .env.example) or liff-entry
# cannot compute the same blind-index hash workforce.employee_line_links was
# written with, and every lookup will miss.
PII_HASH_PEPPER=replace-with-a-long-random-string

# Base URL the Supabase invite email's link redirects back to after
# verification. Must match supabase/config.toml's [auth] site_url locally.
SITE_URL=http://localhost:3000
