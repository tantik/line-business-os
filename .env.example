# ---------------------------------------------------------------------------
# LINE Business OS — environment template
# Copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Supabase / Postgres ---------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# service_role is SERVER-ONLY. Never expose to the browser / web app bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- PII protection --------------------------------------------------------
# 32-byte key (base64) used for AES-256-GCM column encryption.
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Pepper added before hashing searchable PII (blind index). Server-only.
PII_HASH_PEPPER=replace-with-long-random-pepper

# --- LINE Messaging API ----------------------------------------------------
LINE_CHANNEL_SECRET=replace-with-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-channel-access-token
LINE_LIFF_ID=replace-with-liff-id

# --- Web (Next.js public vars; only NEXT_PUBLIC_* reach the browser) -------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_LIFF_ID=replace-with-liff-id

# --- API ------------------------------------------------------------------
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
