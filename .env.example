# ===========================================================================
# LINE Business OS — environment reference / template
# ===========================================================================
#
# NEVER commit real secrets. `.env` and `.env.*` are gitignored; only this
# `.env.example` is tracked. Placeholders/comments only in this file.
#
# This file is a REPOSITORY-LEVEL REFERENCE. It lists every environment
# variable the repo's code and first-party tooling read, grouped by trust and
# operational ownership. It does NOT imply every variable belongs in one
# physical root `.env` — the "Where it lives" note on each group is the
# authority. Full detail: docs/operations/env-inventory.md.
#
# OWNERSHIP / LOCATION MODEL (see docs/operations/env-inventory.md):
#   - Repo-root `.env`            → generic server/operator secret store, read
#                                   via `serverEnv()` for packages/db operator
#                                   scripts, migrations, seed/onboarding (local
#                                   AND Cloud DEV — same names, Cloud values).
#   - `apps/web/.env.local`       → Next.js app env (Next auto-loads it):
#                                   NEXT_PUBLIC_* + apps/web server-only config.
#   - `supabase/functions/.env`   → local Edge Function secrets (own template:
#                                   supabase/functions/.env.example).
#   - Operator shell / password manager → operator tooling credentials that no
#                                   deployed app runtime needs.
#   - Vercel / Supabase dashboards → the same names with deployment values
#                                   (external; out of scope for repo cleanup).
#
# SECURITY: privileged credentials (SUPABASE_SECRET_KEY, DATABASE_URL, PII_*,
# LINE_* secrets, provider API keys) are SERVER-ONLY. They must never carry a
# NEXT_PUBLIC_ prefix and never reach the browser bundle. Least privilege:
# do not copy a privileged key into an app-local env file unless that app's
# deployed runtime provably needs it.
#
# Do NOT merge Mame To Cha env conventions into this file — see
# "DEFERRED LEGACY" at the bottom.
# ---------------------------------------------------------------------------

NODE_ENV=development


# ===========================================================================
# 1. PUBLIC / BROWSER CONFIGURATION
#    Trust: browser-public (inlined into the client bundle by Next.js).
#    Where it lives: apps/web/.env.local (local) / Vercel project env (public).
#    Never a secret; safe only because RLS still applies.
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Low-privilege browser API key. REQUIRED: one `sb_publishable_*` value
# (current model). The legacy `NEXT_PUBLIC_SUPABASE_ANON_KEY` fallback was
# removed in Phase 9 of the key migration
# (docs/operations/supabase-secret-key-migration-runbook.md).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-a-publishable-key-value
# LIFF app id exposed to the browser (LINE/LIFF entry). Optional; the
# liff-entry flow shows a "not configured" state when unset.
NEXT_PUBLIC_LIFF_ID=replace-with-liff-id


# ===========================================================================
# 2. SERVER APPLICATION CONFIGURATION
#    Trust: server-only, NOT secret (no credential value).
#    Where it lives: apps/web/.env.local (local) / Vercel server scope; or the
#    apps/api process env. Never prefix with NEXT_PUBLIC_.
# ===========================================================================
# apps/api HTTP config (apps/api is not deployed yet).
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# apps/web -> apps/api base URL for the local/dev auth-boundary smoke helper
# (apps/web/src/lib/api/auth-boundary-smoke.ts). Server-read only.
LINE_OS_API_INTERNAL_URL=http://localhost:3001
# Server-side copies of the public Supabase values, read by `serverEnv()` for
# packages/db operator scripts. Same values as the NEXT_PUBLIC_* pair above;
# the split is intentional — Next.js requires the NEXT_PUBLIC_ prefix to inline
# a value into the browser bundle, so the browser and the operator scripts
# each need the name in their own trust surface.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-a-publishable-key-value


# ===========================================================================
# 3. PRIVILEGED SERVER / OPERATOR SECRETS
#    Trust: SECRET. RLS-bypassing or credential material. Server-only.
#    Where it lives: repo-root `.env` + operator shell / password manager;
#    Vercel server scope ONLY if/when a server runtime that needs them is
#    deployed. Never in the browser bundle (ESLint guardrail enforces this
#    for the Supabase secret key).
# ===========================================================================
# Privileged (RLS-bypassing) Supabase key — one `sb_secret_*` value (current
# model). The legacy `SUPABASE_SERVICE_ROLE_KEY` fallback was removed in
# Phase 9. `serverEnv().supabasePrivilegedKey` / `createServiceClient()`.
SUPABASE_SECRET_KEY=replace-with-a-secret-key-value
# Postgres connection for server-side tooling (migrations, seed, backup,
# onboarding). Guarded as local (127.0.0.1:54322) by the write paths.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# PII column protection. 32-byte base64 key for AES-256-GCM; pepper for blind
# indexes. Also required (matching values) by the Edge Functions — see
# supabase/functions/.env.example.
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
PII_HASH_PEPPER=replace-with-long-random-pepper
# LINE Messaging API (future; apps/api LINE webhook reads LINE_CHANNEL_SECRET).
LINE_CHANNEL_SECRET=replace-with-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-channel-access-token


# ===========================================================================
# 4. TRANSLATION / PROVIDER CONFIGURATION (apps/web, server-only)
#    Read only in apps/web/src/lib/content/translation-env.ts, never from a
#    'use client' file (enforced by a repo-wide scan test). Used by the
#    Manager "Generate translation" recipe workflow only.
#    Where it lives: apps/web/.env.local (local) / Vercel server scope.
# ===========================================================================
# Explicit provider selector: `deepl` | `openai` | `google`. Unset or
# unsupported => automatic translation is OFF (Manager can still translate by
# hand). No "whichever key is set" fallback.
CONTENT_TRANSLATION_PROVIDER=
# Server-side kill switch, independent of provider config. `false`/`0`
# disables automatic translation. Default: enabled.
CONTENT_TRANSLATION_AUTO_ENABLED=true
# DeepL provider (CONTENT_TRANSLATION_PROVIDER=deepl). API key is SECRET.
DEEPL_API_KEY=replace-with-deepl-api-key
# Optional DeepL endpoint override. Normally unset — the endpoint is resolved
# from the key format (Free keys end in ":fx"). Read now by translation-env.ts.
DEEPL_API_URL=
# OpenAI provider (CONTENT_TRANSLATION_PROVIDER=openai). API key is SECRET.
# NOTE: the future AI module will reuse this same name in its own separate
# deployment — same name, independent consumer, not a shared runtime value.
OPENAI_API_KEY=replace-with-openai-api-key
# Optional: overrides the default OpenAI model (gpt-4o-mini) for translation.
OPENAI_TRANSLATION_MODEL=
# Google Cloud Translation provider (CONTENT_TRANSLATION_PROVIDER=google).
# API key is SECRET; sent via the x-goog-api-key header, never a URL query.
GOOGLE_TRANSLATE_API_KEY=replace-with-google-translate-api-key


# ===========================================================================
# 5. OPERATOR / BACKUP / FIXTURE TOOLING
#    Trust: mix of SECRET (creds) and non-secret config.
#    Where it lives: operator shell / password manager ONLY. No deployed app
#    runtime reads these. Set them for the duration of a run and clear after.
# ===========================================================================
# Local encrypted backup tool (`pnpm db:backup`). Reads DATABASE_URL (§3) +:
BACKUP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Optional: output dir override (default: repo-root `backups/`).
BACKUP_OUTPUT_DIR=
# Optional: daily backups to keep (default 7; never below 7).
BACKUP_RETENTION_COUNT=7
# Ad-hoc staff-auth concurrency check (packages/db/scripts/staff-auth-concurrency-check.ts).
STAFF_AUTH_CONCURRENCY_DB_URL=
# oruwa-cafe reference-tenant fixture (`pnpm --filter @line-os/db oruwa-cafe-fixture`).
# Manager account password used to read the roster / record a stock count.
ORUWA_CAFE_MANAGER_PASSWORD=replace-with-reference-tenant-manager-password
# Recipe-translation generator script (apps/web/scripts/generate-recipe-translations.ts).
RECIPE_TRANSLATION_MANAGER_EMAIL=replace-with-manager-email
RECIPE_TRANSLATION_MANAGER_PASSWORD=replace-with-manager-password
# Optional: defaults to `mame-to-cha` (the reference tenant slug).
RECIPE_TRANSLATION_TENANT_SLUG=
# Optional: set to `yes` to skip the interactive confirm; `true` to replace
# stale-reviewed translations.
RECIPE_TRANSLATION_CONFIRM=
RECIPE_TRANSLATION_REPLACE_STALE_REVIEWED=
# Future Cloud CLI operations (documented, not yet consumed by code):
#   SUPABASE_ACCESS_TOKEN   — personal access token for CLI/CI Cloud ops
#   SUPABASE_PROJECT_REF    — Supabase project reference id
#   SUPABASE_DB_PASSWORD    — database password (password manager only)


# ===========================================================================
# 6. RESERVED / CURRENTLY UNUSED
#    Declared in the codebase but with no current consumer. Kept because the
#    integration is a planned direction; not dead config.
# ===========================================================================
# Server-side LIFF app id. Present in the `serverEnv()` schema (optional) with
# NO current consumer — the browser path uses NEXT_PUBLIC_LIFF_ID (§1). Kept
# for the planned LINE/LIFF server integration. Do not remove.
LINE_LIFF_ID=replace-with-liff-id


# ===========================================================================
# 7. DEFERRED LEGACY CONFIGURATION
#    Do NOT add generic ORUWA variables here or extend these conventions.
# ===========================================================================
# Repo-root `.env.local` holds the deprecated NON-CLOUD Mame To Cha
# pilot/rehearsal tooling env (`MAME_TO_CHA_LOCAL_*`, `MAME_TO_CHA_FIXTURE`,
# `MAME_TO_CHA_WRITE_SQL`, `MAME_TO_CHA_CLEANUP_SQL`). It is kept separate and
# is a deletion candidate pending a generic fixture/onboarding reconciliation,
# together with the rest of the non-cloud `mame-to-cha-*` tooling.
# The Cloud-specific Mame To Cha tooling and its `.env.cloud.local` /
# `MAME_TO_CHA_CLOUD_*` vars were removed in Sept 2026.
