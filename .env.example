# ---------------------------------------------------------------------------
# LINE Business OS — environment template
#
# Copy to the repo-root `.env` and fill in. NEVER commit real secrets
# (`.env` and `.env.*` are gitignored; only this `.env.example` is tracked).
#
# Repo-root `.env` is the GENERIC, tenant-neutral ORUWA server/operator secret
# store: it feeds `serverEnv()` (via `process.env`) for `packages/db` operator
# scripts, migrations, and seed/onboarding runs, both local and Cloud DEV (same
# variable names, Cloud DEV values). See docs/operations/env-inventory.md and
# docs/supabase-cloud-dev-setup.md.
#
# Do NOT merge Mame To Cha env conventions into this file. Repo-root
# `.env.local` / `.env.cloud.local` are deprecated Mame To Cha tooling
# (`MAME_TO_CHA_*`), kept separate and slated for removal — never add generic
# ORUWA variables there.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Supabase / Postgres ---------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# Privileged (RLS-bypassing) Supabase key — SERVER-ONLY, never in the browser
# bundle. Set AT LEAST ONE of the two below (server code picks SECRET_KEY
# first; if both are set, SERVICE_ROLE_KEY stays as an untriggered fallback):
#   * SUPABASE_SECRET_KEY  — preferred: one `sb_secret_*` value (current model)
#   * SUPABASE_SERVICE_ROLE_KEY — legacy JWT service_role, temporary fallback
#     during the migration (docs/operations/supabase-secret-key-migration-runbook.md)
SUPABASE_SECRET_KEY=replace-with-a-secret-key-value
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- PII protection --------------------------------------------------------
# 32-byte key (base64) used for AES-256-GCM column encryption.
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Pepper added before hashing searchable PII (blind index). Server-only.
PII_HASH_PEPPER=replace-with-long-random-pepper

# --- LINE Messaging API ----------------------------------------------------
LINE_CHANNEL_SECRET=replace-with-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=replace-with-channel-access-token
LINE_LIFF_ID=replace-with-liff-id

# --- Web (Next.js public vars; only NEXT_PUBLIC_* reach the browser) -------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_LIFF_ID=replace-with-liff-id

# --- API ------------------------------------------------------------------
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- apps/web -> apps/api (server-only; NEVER prefix with NEXT_PUBLIC_) ----
# Local/dev-only apps/api base URL for the auth-boundary smoke helper
# (apps/web/src/lib/api/auth-boundary-smoke.ts). Read server-side only.
LINE_OS_API_INTERNAL_URL=http://localhost:3001

# --- DeepL translation (server-only; NEVER prefix with NEXT_PUBLIC_) -------
# Used only by the Manager "Generate English translation" recipe workflow
# (apps/web/src/lib/content/*). Never read in a 'use client' component, never
# called during Staff recipe read/render. Leave DEEPL_API_KEY unset to run in
# manual-translation-only mode (Manager still sees a "not configured" message
# and can still enter/save translations by hand; Staff reading is unaffected).
DEEPL_API_KEY=replace-with-deepl-api-key
# Optional: only needed to override the endpoint auto-selected from the key
# (DeepL API Free keys end in ":fx" and use api-free.deepl.com; Pro keys use
# api.deepl.com). Leave unset unless you know you need a different endpoint.
DEEPL_API_URL=
# Optional server-side kill switch for automatic translation, independent of
# whether DEEPL_API_KEY is set (default: enabled). A stand-in for a future
# per-tenant opt-out setting -- see docs/phase-1o-inventory-daily-stock-check-implementation-report.md.
CONTENT_TRANSLATION_AUTO_ENABLED=true
